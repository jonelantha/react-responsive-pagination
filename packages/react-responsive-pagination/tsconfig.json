{
  "extends": "../../tsconfig/tsconfig.code-styles",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2017"],
    "types": ["node"],
    "module": "node16",
    "moduleResolution": "node16",
    "jsx": "react",
    "rootDir": "./src",
    "declaration": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["./src"]
}

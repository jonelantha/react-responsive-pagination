---
import { getCollection } from 'astro:content';
import type { MarkdownRenderer } from '../markdown/renderer.ts';
import { getPageUrl } from '../utils.ts';

// The list of the other pages, for the Markdown home page, in the order of the side
// navigation (pages not in it come last, by name). The HTML pages have their own
// navigation, so this is not rendered on the web.
export const markdownRenderer: MarkdownRenderer = async () => {
  const order = (doc: { data: { sideNavOrder?: number } }) =>
    doc.data.sideNavOrder ?? Number.MAX_SAFE_INTEGER;

  const docs = (await getCollection('docs'))
    .filter(doc => getPageUrl(doc) !== '/')
    .sort((a, b) => order(a) - order(b) || a.id.localeCompare(b.id, 'en'));

  return docs
    .map(doc => `- [${doc.data.navTitle}](${getPageUrl(doc)}) - ${doc.data.summary}`)
    .join('\n');
};
---

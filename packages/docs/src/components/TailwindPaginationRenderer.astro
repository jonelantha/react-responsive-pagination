---
import PaginationRenderer, {
  type PaginationRendererProps,
} from './PaginationRenderer';
import { twExamples } from './tailwind-examples.ts';

type Props = PaginationRendererProps & { example?: keyof typeof twExamples };

const { example, ...rest } = Astro.props;

export const markdownRenderer = 'skip';
---

<PaginationRenderer
  {...(example ? twExamples[example] : {})}
  {...rest}
  className="tailwind-preflight"
  client:load
/>

<style is:global lang="scss">
  @use 'sass:meta';

  .tailwind-preflight {
    @include meta.load-css('@styles/tailwind-preflight');
  }
</style>

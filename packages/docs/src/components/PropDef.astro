---
import type { MarkdownRenderer } from '../markdown/renderer.ts';

export interface Props {
  name: string;
  type: string;
  defaultValue?: string;
}

export const markdownRenderer: MarkdownRenderer<Props> = (
  { name, type, defaultValue },
  children,
) =>
  [
    `### \`${name}\``,
    `Type: \`${type}\` · ${defaultValue ? 'optional' : 'required'}`,
    children,
  ]
    .filter(Boolean)
    .join('\n\n');

const { type, defaultValue, name } = Astro.props;
---

<tr>
  <td>
    <div id={name}>{name}</div>
    <code>{type}</code>
    <br />
    <em>{defaultValue ? '(optional)' : '(required)'}</em>
  </td>
  <td>
    <slot />
  </td>
</tr>

<style lang="scss">
  @use '@styles/_vars.scss';

  div {
    font-weight: vars.$font-weight-bold;
  }
</style>

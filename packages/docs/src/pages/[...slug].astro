---
import { type CollectionEntry, getCollection } from 'astro:content';
import Main from '../layouts/Main.astro';
import Document from '../layouts/Document.astro';
import Table from '../components/Table.astro';
import { render } from 'astro:content';
import { getMarkdownUrl } from '../utils.ts';

export async function getStaticPaths() {
  return (await getCollection('docs')).map(doc => ({
    params: { slug: doc.id === 'index' ? undefined : doc.id },
    props: doc,
  }));
}
type Props = CollectionEntry<'docs'>;

const doc = Astro.props;
const { Content } = await render(doc);
---

<Main {...doc.data} markdownUrl={getMarkdownUrl(doc)}>
  <Document
    popupNavOnly={doc.data.popupNavOnly}
    noArticlePadding={doc.data.noArticlePadding}
  >
    <Content components={{ table: Table }} />
  </Document>
</Main>

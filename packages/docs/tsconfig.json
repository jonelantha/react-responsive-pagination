{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "eslint.config.js"],
  "compilerOptions": {
    "strictNullChecks": true,
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@props/*": ["./src/content/props/*"]
    }
  }
}

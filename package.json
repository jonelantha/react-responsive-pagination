{
  "name": "react-responsive-pagination-workspace",
  "private": true,
  "workspaces": [
    "packages/**"
  ],
  "type": "module",
  "scripts": {
    "start": "npm run start -w react-responsive-pagination",
    "build": "npm run build -w react-responsive-pagination",
    "release": "npm run release -w react-responsive-pagination",
    "release-dry-run": "npm run release-dry-run -w react-responsive-pagination",
    "test": "npm run test -w react-responsive-pagination",
    "integration-test": "npm run test -w integration-test",
    "start-test-harness": "npm run start -w test-harness-react-19",
    "check": "npm run build && npm run tsc && npm run lint && npm run format-check && npm run test && npm run integration-test && npm run build-docs && npm run test-docs",
    "browser-test-17": "node scripts/browser-test.ts 17",
    "browser-test-18": "node scripts/browser-test.ts 18",
    "browser-test-19": "node scripts/browser-test.ts 19",
    "browser-test-quick": "node scripts/browser-test.ts 19 --quick",
    "package-size": "node scripts/package-size.ts",
    "browser-test-dev": "npm run test-dev-chrome -w browser-test",
    "start-docs": "npm run dev -w docs",
    "build-docs": "npm run build -w docs",
    "test-docs": "npm run test -w docs",
    "test-docs:update": "npm run test:update -w docs",
    "tsc": "npm run tsc-config && npm run tsc --workspaces",
    "tsc-config": "tsc --p ./tsconfig/tsconfig.config-files.json",
    "lint": "npm run lint --workspaces",
    "format-check": "prettier --check ."
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "bootstrap": "5.3.8",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "formik": "2.4.9",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-responsive-pagination": "file:./packages/react-responsive-pagination",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
